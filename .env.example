# --- Browser (build time, Vite). Leave empty for same-origin (the normal setup when `npm start` serves everything). ---
# WebSocket URL of the room server, only needed when it runs on a different host than the page.
# VITE_SERVER_URL=wss://doodle-brawl-rooms.example.com/ws
# Public address used for share links and QR codes (default: the address the page was opened from).
# VITE_PUBLIC_URL=https://doodle-brawl.example.com
# Delay of the HOST's own input, for fairness: "auto" (default, follows the other players' latency) or a number of frames (0-5; 0 = off).
# VITE_HOST_INPUT_DELAY=auto

# --- Room server (runtime, `npm start` / `npm run server`) ---
PORT=8080
HOST=0.0.0.0
# Comma separated list of page origins allowed to open a WebSocket. Empty = any origin.
# ALLOWED_ORIGINS=https://doodle-brawl.example.com
MAX_ROOMS=200
# Set to 1 to log room events to the console.
# NET_LOG=1
